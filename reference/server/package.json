{
  "name": "@phosra/reference-server",
  "version": "0.1.0",
  "description": "Reference TypeScript server implementing the PCSS v1.0 OpenAPI surface.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/phosra-spec/pcss",
    "directory": "reference/server"
  },
  "type": "module",
  "main": "./src/main.ts",
  "bin": {
    "pcss-reference-server": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsup src/main.ts --format esm --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosra/sdk": "workspace:*",
    "@phosra/types": "workspace:*",
    "@noble/ed25519": "^2.1.0",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
