{
  "name": "@phosra/sdk-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for the PCSS reference TypeScript SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phosra-spec/pcss",
    "directory": "sdk-typescript"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
