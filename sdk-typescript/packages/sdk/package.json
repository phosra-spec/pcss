{
  "name": "@phosra/sdk",
  "version": "0.1.0",
  "description": "Reference TypeScript SDK for the Phosra Child Safety Specification (PCSS) v1.0.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phosra-spec/pcss",
    "directory": "sdk-typescript/packages/sdk"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts src/browser/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@phosra/types": "workspace:*",
    "@noble/ed25519": "^2.1.0"
  },
  "peerDependencies": {
    "ajv": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
