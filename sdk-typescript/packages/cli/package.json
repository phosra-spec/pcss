{
  "name": "@phosra/cli",
  "version": "0.1.0",
  "description": "CLI for the Phosra Child Safety Specification (PCSS) — verify, conformance, types.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phosra-spec/pcss",
    "directory": "sdk-typescript/packages/cli"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "bin": {
    "phosra": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@phosra/sdk": "workspace:*",
    "@phosra/conformance": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
