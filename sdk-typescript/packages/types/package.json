{
  "name": "@phosra/types",
  "version": "0.1.0",
  "description": "TypeScript types for the Phosra Child Safety Specification (PCSS) v1.0.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phosra-spec/pcss",
    "directory": "sdk-typescript/packages/types"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "generate": "node scripts/generate.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
