{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcss.phosra-spec.org/v1/schema/herald.json",
  "title": "PCSS Herald Envelope",
  "description": "Notification and reporting envelope. Emitted by Lens / Aegis / Notary consumers and routed to parent, regulator, or civil-society subscribers. See PCSS \u00a77.",
  "type": "object",
  "required": [
    "herald_id",
    "surface",
    "events",
    "issued_at",
    "issuer",
    "signature"
  ],
  "properties": {
    "herald_id": {
      "type": "string",
      "description": "Stable, opaque identifier for this herald envelope.",
      "pattern": "^hrld_[A-Za-z0-9_-]{16,128}$"
    },
    "surface": {
      "type": "string",
      "description": "The notification destination.",
      "enum": [
        "parent",
        "regulator",
        "civil-society"
      ]
    },
    "cadence": {
      "type": "string",
      "description": "The cadence under which this envelope is being delivered. 'immediate' MUST be used for Aegis hard-block events; 'daily' for privacy events; 'weekly' for aggregate usage.",
      "enum": [
        "immediate",
        "daily",
        "weekly",
        "monthly",
        "on-request"
      ]
    },
    "events": {
      "type": "array",
      "description": "The events being heralded. Each event references a receipt (for verdict events) or a bearing/threshold ID (for state-change events).",
      "items": {
        "type": "object",
        "required": [
          "event_type",
          "occurred_at"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "description": "Canonical event type. 'verdict:block' / 'verdict:allow' for Lens/Aegis decisions; 'threshold:granted' / 'threshold:revoked' for consent state; 'custody:deleted' for data deletion confirmations; 'bearing:rotated' for age signal rotations.",
            "pattern": "^[a-z]+:[a-z0-9_-]+$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "receipt_id": {
            "type": "string",
            "description": "Reference to a Notary receipt for verdict events.",
            "pattern": "^ntry_[A-Za-z0-9_-]{16,128}$"
          },
          "bearing_id": {
            "type": "string",
            "description": "Opaque reference. Herald envelopes MUST NOT carry user-identifying data beyond the opaque ID.",
            "pattern": "^brng_[A-Za-z0-9_-]{16,128}$"
          },
          "consent_id": {
            "type": "string",
            "pattern": "^thsh_[A-Za-z0-9_-]{16,128}$"
          },
          "summary": {
            "type": "string",
            "description": "Human-readable single-line summary. Required for the 'parent' surface; optional for regulator/civil-society.",
            "maxLength": 280
          },
          "extensions": {
            "type": "object",
            "description": "Implementer-specific extensions. Keys MUST carry a vendor prefix; PII fields are forbidden regardless of prefix.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_-]+$"
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "email"
                  ]
                },
                {
                  "required": [
                    "phone"
                  ]
                },
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "first_name"
                  ]
                },
                {
                  "required": [
                    "last_name"
                  ]
                },
                {
                  "required": [
                    "full_name"
                  ]
                },
                {
                  "required": [
                    "device_id"
                  ]
                },
                {
                  "required": [
                    "imei"
                  ]
                },
                {
                  "required": [
                    "idfa"
                  ]
                },
                {
                  "required": [
                    "gaid"
                  ]
                },
                {
                  "required": [
                    "mac_address"
                  ]
                },
                {
                  "required": [
                    "ssn"
                  ]
                },
                {
                  "required": [
                    "dob"
                  ]
                },
                {
                  "required": [
                    "birth_date"
                  ]
                },
                {
                  "required": [
                    "birthdate"
                  ]
                },
                {
                  "required": [
                    "birthday"
                  ]
                },
                {
                  "required": [
                    "lat"
                  ]
                },
                {
                  "required": [
                    "lon"
                  ]
                },
                {
                  "required": [
                    "latitude"
                  ]
                },
                {
                  "required": [
                    "longitude"
                  ]
                },
                {
                  "required": [
                    "precise_geo"
                  ]
                },
                {
                  "required": [
                    "ip"
                  ]
                },
                {
                  "required": [
                    "ip_address"
                  ]
                }
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the herald envelope was emitted."
    },
    "issuer": {
      "type": "string",
      "description": "Registered identifier of the emitter (e.g., 'platform:roblox', 'app:bark', 'controls:nextdns').",
      "pattern": "^[a-z]+:[a-z0-9-]+$"
    },
    "subscriber": {
      "type": "string",
      "description": "Registered identifier of the recipient (e.g., 'regulator:us-ftc', 'civil-society:commonsense', 'parent:opaque-handle'). MUST be omitted on parent-surface envelopes that carry user-identifying delivery routing in transport metadata.",
      "pattern": "^[a-z]+:[a-z0-9-]+$"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "value",
        "key_id"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "description": "Signature algorithm. v1.0 mandates 'ed25519'. v1.1 adds hybrid suites (e.g., 'ed25519+ml-dsa-65').",
          "pattern": "^[a-z][a-z0-9+-]+$"
        },
        "value": {
          "type": "string",
          "description": "Base64url-encoded 64-byte ed25519 signature. Exactly 86 characters, no padding.",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        },
        "key_id": {
          "type": "string",
          "description": "Signer's key identifier."
        },
        "alternate_signatures": {
          "type": "array",
          "description": "Optional parallel signatures for hybrid suites (e.g., post-quantum). Each MUST sign the same canonical envelope.",
          "items": {
            "type": "object",
            "required": [
              "alg",
              "value",
              "key_id"
            ],
            "properties": {
              "alg": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+-]+$"
              },
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "key_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "object",
          "description": "Per-signature implementer extensions. Keys MUST carry a vendor prefix (e.g., 'apple:'). Keys MUST carry a vendor prefix; PII fields are forbidden regardless of prefix.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_-]+$"
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "phone"
                ]
              },
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "first_name"
                ]
              },
              {
                "required": [
                  "last_name"
                ]
              },
              {
                "required": [
                  "full_name"
                ]
              },
              {
                "required": [
                  "device_id"
                ]
              },
              {
                "required": [
                  "imei"
                ]
              },
              {
                "required": [
                  "idfa"
                ]
              },
              {
                "required": [
                  "gaid"
                ]
              },
              {
                "required": [
                  "mac_address"
                ]
              },
              {
                "required": [
                  "ssn"
                ]
              },
              {
                "required": [
                  "dob"
                ]
              },
              {
                "required": [
                  "birth_date"
                ]
              },
              {
                "required": [
                  "birthdate"
                ]
              },
              {
                "required": [
                  "birthday"
                ]
              },
              {
                "required": [
                  "lat"
                ]
              },
              {
                "required": [
                  "lon"
                ]
              },
              {
                "required": [
                  "latitude"
                ]
              },
              {
                "required": [
                  "longitude"
                ]
              },
              {
                "required": [
                  "precise_geo"
                ]
              },
              {
                "required": [
                  "ip"
                ]
              },
              {
                "required": [
                  "ip_address"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Implementer-specific extensions. Keys MUST carry a vendor prefix; PII fields are forbidden regardless of prefix.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_-]+$"
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "phone"
            ]
          },
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "first_name"
            ]
          },
          {
            "required": [
              "last_name"
            ]
          },
          {
            "required": [
              "full_name"
            ]
          },
          {
            "required": [
              "device_id"
            ]
          },
          {
            "required": [
              "imei"
            ]
          },
          {
            "required": [
              "idfa"
            ]
          },
          {
            "required": [
              "gaid"
            ]
          },
          {
            "required": [
              "mac_address"
            ]
          },
          {
            "required": [
              "ssn"
            ]
          },
          {
            "required": [
              "dob"
            ]
          },
          {
            "required": [
              "birth_date"
            ]
          },
          {
            "required": [
              "birthdate"
            ]
          },
          {
            "required": [
              "birthday"
            ]
          },
          {
            "required": [
              "lat"
            ]
          },
          {
            "required": [
              "lon"
            ]
          },
          {
            "required": [
              "latitude"
            ]
          },
          {
            "required": [
              "longitude"
            ]
          },
          {
            "required": [
              "precise_geo"
            ]
          },
          {
            "required": [
              "ip"
            ]
          },
          {
            "required": [
              "ip_address"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
