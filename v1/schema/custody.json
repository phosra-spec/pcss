{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcss.phosra-spec.org/v1/schema/custody.json",
  "title": "PCSS Custody Envelope",
  "description": "Data-minimization and deletion-rights envelope. Carries retention declarations, deletion requests, and deletion-completion receipts. See PCSS \u00a78.",
  "type": "object",
  "required": [
    "custody_id",
    "action",
    "subject_ref",
    "issued_at",
    "issuer",
    "signature"
  ],
  "properties": {
    "custody_id": {
      "type": "string",
      "description": "Stable, opaque identifier for this custody envelope.",
      "pattern": "^cstd_[A-Za-z0-9_-]{16,128}$"
    },
    "action": {
      "type": "string",
      "description": "The custody action this envelope represents.",
      "enum": [
        "retention-declaration",
        "deletion-request",
        "deletion-completion",
        "export-request",
        "export-completion"
      ]
    },
    "subject_ref": {
      "type": "object",
      "description": "Opaque reference to the subject of this custody envelope. MUST be either a bearing_id (per-child) or a consent_id (per-consent-grant). MUST NOT carry user-identifying data.",
      "properties": {
        "bearing_id": {
          "type": "string",
          "pattern": "^brng_[A-Za-z0-9_-]{16,128}$"
        },
        "consent_id": {
          "type": "string",
          "pattern": "^thsh_[A-Za-z0-9_-]{16,128}$"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "description": "Data scopes affected. 'all' MUST be supported for full deletion. Per-scope deletion uses the same vocabulary as Threshold granted_scope.",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]*:[a-z0-9_-]+|all)$"
      },
      "minItems": 1
    },
    "retention_until": {
      "type": "string",
      "format": "date-time",
      "description": "For retention-declaration: the timestamp beyond which the implementer commits not to retain the data. Default per \u00a78.1: issued_at + 180 days. Statutory overrides (e.g., CSAM evidence preservation) MUST be cited in 'statutory_basis'."
    },
    "statutory_basis": {
      "type": "array",
      "description": "Statute citations that override the default retention. e.g., '18 U.S.C. \u00a72258A' for CSAM preservation.",
      "items": {
        "type": "string"
      }
    },
    "propagation_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "For deletion-request: the timestamp by which the deletion MUST be propagated to downstream consumers (\u00a78.2 default: 30 days from issued_at)."
    },
    "completion_receipt": {
      "type": "object",
      "description": "For deletion-completion: confirmation that the deletion was executed.",
      "properties": {
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        },
        "downstream_consumers": {
          "type": "array",
          "description": "Registered identifiers of downstream consumers to which the deletion was propagated.",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+:[a-z0-9-]+$"
          }
        },
        "tombstone_id": {
          "type": "string",
          "description": "Opaque tombstone identifier retained for audit purposes after the data itself is deleted.",
          "pattern": "^tomb_[A-Za-z0-9_-]{16,128}$"
        }
      },
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "description": "Registered identifier of the entity emitting the envelope.",
      "pattern": "^[a-z]+:[a-z0-9-]+$"
    },
    "jurisdiction": {
      "type": "string",
      "description": "ISO 3166 country code with optional sub-region.",
      "pattern": "^[A-Z]{2}(-[A-Z]{2,3})?$"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "value",
        "key_id"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "description": "Signature algorithm. v1.0 mandates 'ed25519'. v1.1 adds hybrid suites (e.g., 'ed25519+ml-dsa-65').",
          "pattern": "^[a-z][a-z0-9+-]+$"
        },
        "value": {
          "type": "string",
          "description": "Base64url-encoded 64-byte ed25519 signature. Exactly 86 characters, no padding.",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        },
        "key_id": {
          "type": "string",
          "description": "Signer's key identifier."
        },
        "alternate_signatures": {
          "type": "array",
          "description": "Optional parallel signatures for hybrid suites (e.g., post-quantum). Each MUST sign the same canonical envelope.",
          "items": {
            "type": "object",
            "required": [
              "alg",
              "value",
              "key_id"
            ],
            "properties": {
              "alg": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+-]+$"
              },
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "key_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "object",
          "description": "Per-signature implementer extensions. Keys MUST carry a vendor prefix (e.g., 'apple:'). Keys MUST carry a vendor prefix; PII fields are forbidden regardless of prefix.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_-]+$"
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "phone"
                ]
              },
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "first_name"
                ]
              },
              {
                "required": [
                  "last_name"
                ]
              },
              {
                "required": [
                  "full_name"
                ]
              },
              {
                "required": [
                  "device_id"
                ]
              },
              {
                "required": [
                  "imei"
                ]
              },
              {
                "required": [
                  "idfa"
                ]
              },
              {
                "required": [
                  "gaid"
                ]
              },
              {
                "required": [
                  "mac_address"
                ]
              },
              {
                "required": [
                  "ssn"
                ]
              },
              {
                "required": [
                  "dob"
                ]
              },
              {
                "required": [
                  "birth_date"
                ]
              },
              {
                "required": [
                  "birthdate"
                ]
              },
              {
                "required": [
                  "birthday"
                ]
              },
              {
                "required": [
                  "lat"
                ]
              },
              {
                "required": [
                  "lon"
                ]
              },
              {
                "required": [
                  "latitude"
                ]
              },
              {
                "required": [
                  "longitude"
                ]
              },
              {
                "required": [
                  "precise_geo"
                ]
              },
              {
                "required": [
                  "ip"
                ]
              },
              {
                "required": [
                  "ip_address"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Implementer-specific extensions. Keys MUST carry a vendor prefix; PII fields are forbidden regardless of prefix.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_-]+$"
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "phone"
            ]
          },
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "first_name"
            ]
          },
          {
            "required": [
              "last_name"
            ]
          },
          {
            "required": [
              "full_name"
            ]
          },
          {
            "required": [
              "device_id"
            ]
          },
          {
            "required": [
              "imei"
            ]
          },
          {
            "required": [
              "idfa"
            ]
          },
          {
            "required": [
              "gaid"
            ]
          },
          {
            "required": [
              "mac_address"
            ]
          },
          {
            "required": [
              "ssn"
            ]
          },
          {
            "required": [
              "dob"
            ]
          },
          {
            "required": [
              "birth_date"
            ]
          },
          {
            "required": [
              "birthdate"
            ]
          },
          {
            "required": [
              "birthday"
            ]
          },
          {
            "required": [
              "lat"
            ]
          },
          {
            "required": [
              "lon"
            ]
          },
          {
            "required": [
              "latitude"
            ]
          },
          {
            "required": [
              "longitude"
            ]
          },
          {
            "required": [
              "precise_geo"
            ]
          },
          {
            "required": [
              "ip"
            ]
          },
          {
            "required": [
              "ip_address"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
